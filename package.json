{
    "name": "findl",
    "version": "0.7.0",
    "description": "Output all the third-party licenses used in your node or dart based project.",
    "main": "lib/index.js",
    "bin": {
        "findl": "./bin/findl.js"
    },
    "scripts": {
        "build": "vite build",
        "dev": "npx tsx ./index.ts",
        "check:typescript": "./node_modules/typescript/bin/tsc -p ./tsconfig.json --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "yarn build"
    },
    "author": "wdamien",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gskinnerTeam/findl"
    },
    "dependencies": {
        "@octokit/rest": "^22.0.0",
        "async": "^3.2.3",
        "cli-progress": "^3.10.0",
        "colors": "^1.4.0",
        "fs-extra": "^10.0.1",
        "glob": "^10.3.10",
        "ignore": "^5.3.0",
        "node-fetch": "2.6.6",
        "package-json": "^7.0.0",
        "resolve-package-path": "^4.0.3",
        "yaml": "^2.3.4",
        "yamljs": "^0.3.0",
        "yargs": "^17.4.0"
    },
    "devDependencies": {
        "@types/async": "^3.2.12",
        "@types/cli-progress": "^3.9.2",
        "@types/fs-extra": "^9.0.13",
        "@types/node": "^24.4.0",
        "@types/node-fetch": "^2.6.1",
        "@types/yamljs": "^0.2.31",
        "@types/yargs": "^17.0.10",
        "@vitest/ui": "^3.2.4",
        "type-fest": "^2.5.1",
        "typescript": "^5.8.3",
        "vite": "^7.1.5",
        "vitest": "^3.2.4"
    }
}
